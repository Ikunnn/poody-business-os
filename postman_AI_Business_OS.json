          "name": "GET List Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/finance/transactions?business_id={{business_id}}&period=2026-09", "host": ["{{baseUrl}}"], "path": ["finance", "transactions"], "query": [{ "key": "business_id", "value": "{{business_id}}" }, { "key": "period", "value": "2026-09" }] }
          }
        },
        {
          "name": "POST Import Transactions",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/finance/transactions", "host": ["{{baseUrl}}"], "path": ["finance", "transactions"] },
            "body": { "mode": "raw", "raw": "{\n  \"business_id\": \"{{business_id}}\",\n  \"transactions\": [{ \"type\": \"revenue\", \"amount\": 15000000, \"category\": \"sales\", \"occurred_at\": \"2026-09-05T00:00:00+07:00\", \"source\": \"sheets\" }]\n}" }
          }
        }
      ]
    },
