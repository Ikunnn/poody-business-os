{
  "info": {
    "name": "AI Business OS - API Collection",
    "description": "Import langsung ke Postman. Set variable baseUrl & access_token dulu. Dibuat dari PRD Agentic AI Business OS (CEO + 16 agents). Base URL default production, ganti ke localhost:8000 untuk dev.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.aicompanyos.com/api/v1" },
    { "key": "localUrl", "value": "http://localhost:8000/api/v1" },
    { "key": "access_token", "value": "PASTE_JWT_HERE" },
    { "key": "business_id", "value": "biz_123" },
    { "key": "workflow_id", "value": "wf_abc123" },
    { "key": "task_id", "value": "tsk_1" },
    { "key": "approval_id", "value": "apr_123" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": ["// Auto-set baseUrl ke local jika mau dev", "// pm.variables.set('baseUrl', pm.variables.get('localUrl'))"],
        "type": "text/javascript"
      }
    }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "POST Login - dapat JWT",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"owner@brand.com\",\n  \"password\": \"rahasia123\"\n}" },
            "description": "Login, copy access_token ke variable {{access_token}}. Tanpa auth."
          }
        },
        {
          "name": "POST Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"PASTE_REFRESH_HERE\"\n}" }
          }
        },
        {
          "name": "GET Me - cek user login",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "02 - Businesses (Onboarding)",
      "item": [
        {
          "name": "POST Create Business",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/businesses", "host": ["{{baseUrl}}"], "path": ["businesses"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Brand Fashion A\",\n  \"industry\": \"Fashion Retail\",\n  \"products\": [{ \"name\": \"Kemeja Linen\", \"price\": 170000, \"cogs\": 95000 }],\n  \"target_market\": \"Wanita 25-35 Jabodetabek\",\n  \"business_model\": \"D2C via Marketplace + IG\",\n  \"goals\": [\"profit +20% dalam 3 bulan\"]\n}" }
          }
        },
        {
          "name": "GET List Businesses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/businesses", "host": ["{{baseUrl}}"], "path": ["businesses"] }
          }
        },
        {
          "name": "GET Business Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/businesses/{{business_id}}", "host": ["{{baseUrl}}"], "path": ["businesses", "{{business_id}}"] }
          }
        },
        {
          "name": "PATCH Update Business",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/businesses/{{business_id}}", "host": ["{{baseUrl}}"], "path": ["businesses", "{{business_id}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"target_market\": \"Wanita 25-35 + Pria 28-40 Jabodetabek & Surabaya\"\n}" }
          }
        }
      ]
    },
    {
      "name": "03 - Agents & Chat",
      "item": [
        {
          "name": "GET List 16 Agents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/agents", "host": ["{{baseUrl}}"], "path": ["agents"] }
          }
        },
        {
          "name": "POST Chat CEO (SSE streaming)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Accept", "value": "text/event-stream" }
            ],
            "url": { "raw": "{{baseUrl}}/agents/ceo/chat", "host": ["{{baseUrl}}"], "path": ["agents", "ceo", "chat"] },
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"Kenapa profit turun bulan ini?\",\n  \"business_id\": \"{{business_id}}\",\n  \"stream\": true\n}" },
            "description": "Di Postman akan terlihat sebagai SSE events: agent_thinking -> delegate -> token -> done"
          }
        },
        {
          "name": "POST Chat Finance Manager",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/agents/finance_manager/chat", "host": ["{{baseUrl}}"], "path": ["agents", "finance_manager", "chat"] },
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"Apakah bisnis saya untung bulan ini? Hitung margin per produk.\",\n  \"business_id\": \"{{business_id}}\"\n}" }
          }
        }
      ]
    },
    {
      "name": "04 - Workflows (CEO Orchestrator) - PENTING",
      "item": [
        {
          "name": "POST Create Workflow - Naikkan Profit 20%",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/workflows", "host": ["{{baseUrl}}"], "path": ["workflows"] },
            "body": { "mode": "raw", "raw": "{\n  \"business_id\": \"{{business_id}}\",\n  \"objective\": \"Naikkan profit 20% dalam 3 bulan\",\n  \"priority\": \"high\"\n}" },
            "description": "Kirim 1 kalimat, CEO pecah jadi DAG task untuk Finance/Marketing/Strategy"
          }
        },
        {
          "name": "POST Create Workflow - Buat Campaign",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/workflows", "host": ["{{baseUrl}}"], "path": ["workflows"] },
            "body": { "mode": "raw", "raw": "{\n  \"business_id\": \"{{business_id}}\",\n  \"objective\": \"Buat campaign untuk meningkatkan penjualan produk A\",\n  \"priority\": \"high\"\n}" }
          }
        },
        {
          "name": "GET List Workflows",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/workflows?business_id={{business_id}}", "host": ["{{baseUrl}}"], "path": ["workflows"], "query": [{ "key": "business_id", "value": "{{business_id}}" }] }
          }
        },
        {
          "name": "GET Workflow Detail + Progress",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/workflows/{{workflow_id}}", "host": ["{{baseUrl}}"], "path": ["workflows", "{{workflow_id}}"] }
          }
        },
        {
          "name": "POST Approve Workflow (HITL)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/workflows/{{workflow_id}}/approve", "host": ["{{baseUrl}}"], "path": ["workflows", "{{workflow_id}}", "approve"] },
            "body": { "mode": "raw", "raw": "{\n  \"decision\": \"approved\",\n  \"reason\": \"Setuju scenario E (kombinasi naik harga + optimasi ROAS)\"\n}" }
          }
        }
      ]
    },
    {
      "name": "05 - Tasks",
      "item": [
        {
          "name": "POST Create Task Manual",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] },
            "body": { "mode": "raw", "raw": "{\n  \"workflow_id\": \"{{workflow_id}}\",\n  \"agent\": \"financial_analyst\",\n  \"objective\": \"Analisis margin per produk Q1\",\n  \"priority\": \"high\"\n}" }
          }
        },
        {
          "name": "GET List Tasks by Workflow",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/tasks?workflow_id={{workflow_id}}", "host": ["{{baseUrl}}"], "path": ["tasks"], "query": [{ "key": "workflow_id", "value": "{{workflow_id}}" }] }
          }
        },
        {
          "name": "GET Task Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/tasks/{{task_id}}", "host": ["{{baseUrl}}"], "path": ["tasks", "{{task_id}}"] }
          }
        },
        {
          "name": "PATCH Update Task Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/tasks/{{task_id}}", "host": ["{{baseUrl}}"], "path": ["tasks", "{{task_id}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"completed\",\n  \"confidence\": 82,\n  \"output\": { \"summary\": \"Margin tertinggi produk A 42%\" }\n}" }
          }
        }
      ]
    },
    {
      "name": "06 - Finance",
      "item": [
