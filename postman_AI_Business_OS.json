          "name": "GET Cashflow + Runway 13w",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/finance/cashflow?business_id={{business_id}}", "host": ["{{baseUrl}}"], "path": ["finance", "cashflow"], "query": [{ "key": "business_id", "value": "{{business_id}}" }] }
          }
        },
        {
          "name": "POST Finance Analysis (margin/BEP/CAC)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/finance/analysis", "host": ["{{baseUrl}}"], "path": ["finance", "analysis"] },
            "body": { "mode": "raw", "raw": "{\n  \"business_id\": \"{{business_id}}\",\n  \"period\": \"2026-Q1\",\n  \"questions\": [\"Apakah bisnis untung?\", \"Produk paling profitable?\"]\n}" }
          }
        },
        {
          "name": "POST Forecast 3 Bulan (best/base/worst)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/finance/forecast", "host": ["{{baseUrl}}"], "path": ["finance", "forecast"] },
            "body": { "mode": "raw", "raw": "{\n  \"business_id\": \"{{business_id}}\",\n  \"months\": 3,\n  \"scenario\": \"all\"\n}" }
          }
        },
